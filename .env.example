POSTGRES_USER=iot
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=environment
DATABASE_URL=postgresql+psycopg://iot:local-development-only@localhost:5432/environment
INGEST_API_KEY=change-this-local-key
# Substitua pelo IP exibido no Monitor Serial da ESP32.
ESP32_URL=http://192.168.1.100/
DEVICE_ID=esp32-01
API_BASE_URL=http://127.0.0.1:8000
POLL_SECONDS=10
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ML_AUTO_TRAIN_ENABLED=true
ML_CHECK_SECONDS=300
ML_RETRAIN_SECONDS=3600
ML_MIN_NEW_SAMPLES=120
